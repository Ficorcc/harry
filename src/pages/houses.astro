---
import BaseLayout from "@layouts/BaseLayout.astro";
import HouseBadge from "@components/HouseBadge.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { houses } from "@data/theme";
---

<BaseLayout title="学院" description="魔法学院主题的学院专题页面。">
  <section class="page-hero house-hero">
    <div class="container">
      <p class="eyebrow">Houses</p>
      <h1>学院专题</h1>
      <p>把学院色彩变成可复用的视觉系统，用在分类、专题和角色页上。</p>
    </div>
  </section>
  <section class="section parchment-section">
    <div class="container">
      <SectionHeader title="House Palette" copy="每个学院都有主色、辅色和一句气质描述。" />
      <div class="house-grid roomy">
        {houses.map((house) => (
          <article
            class="house-card"
            id={`${house.id}-card`}
            style={`--swatch-a:${house.colors[0]};--swatch-b:${house.colors[1]};`}
          >
            <HouseBadge house={house} />
            <div class="swatches" aria-hidden="true">
              <span></span>
              <span></span>
            </div>
            <h2>
              <button
                class="house-name-button"
                type="button"
                data-house-open={house.id}
                aria-haspopup="dialog"
                aria-controls={`${house.id}-dialog`}
              >
                {house.cn}
              </button>
            </h2>
            <p>{house.name}</p>
            <small>{house.motto}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  {houses.map((house) => (
    <dialog class="house-dialog" id={`${house.id}-dialog`} aria-labelledby={`${house.id}-title`}>
      <div class="dialog-panel" style={`--swatch-a:${house.colors[0]};--swatch-b:${house.colors[1]};`}>
        <button class="dialog-close" type="button" data-house-close aria-label="关闭介绍">×</button>
        <div class="dialog-heading">
          <HouseBadge house={house} size="dialog" />
          <div>
            <p class="eyebrow">{house.name}</p>
            <h2 id={`${house.id}-title`}>{house.cn}</h2>
            <p>{house.motto}</p>
          </div>
        </div>
        <div class="dialog-content">
          <section>
            <h3>学院介绍</h3>
            <p>{house.summary}</p>
            {house.details.map((detail) => <p>{detail}</p>)}
          </section>
          <section>
            <h3>主要人物</h3>
            <div class="character-list">
              {house.people.map((person) => (
                <article>
                  <strong>{person.name}</strong>
                  <p>{person.role}</p>
                </article>
              ))}
            </div>
          </section>
        </div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<script>
  const openButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-house-open]"));
  const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>(".house-dialog"));

  openButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = document.getElementById(`${button.dataset.houseOpen}-dialog`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  dialogs.forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.querySelector("[data-house-close]")?.addEventListener("click", () => {
      dialog.close();
    });
  });
</script>
