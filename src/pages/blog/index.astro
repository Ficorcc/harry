---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { posts } from "@data/theme";
---

<BaseLayout title="文章" description="魔法学院主题的文章归档页面。">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Archive</p>
      <h1>文章归档</h1>
      <p>用复古报纸与魔法书之间的视觉语气，组织你的影评、设定和随笔。</p>
    </div>
  </section>
  <section class="section parchment-section">
    <div class="container">
      <SectionHeader title="Latest Dispatches" copy="演示文章来自本地数据文件，方便替换成你自己的内容。" />
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
