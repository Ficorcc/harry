---
interface Props {
  house: {
    id: string;
    cn: string;
    name: string;
    badgeUrl: string;
  };
  size?: "card" | "dialog";
}

const { house, size = "card" } = Astro.props;
---

<figure class:list={["house-badge", `house-badge-${size}`, `house-badge-${house.id}`]}>
  <img src={house.badgeUrl} alt={`${house.cn}官方垂挂旗徽`} loading="lazy" decoding="async" />
</figure>
